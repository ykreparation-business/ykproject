# Copy to .env.local and fill in real values. Never commit .env.local.

# Resend (https://resend.com) - used by app/api/devis/route.ts to send
# the quote-request notification and prospect confirmation emails.
RESEND_API_KEY=

# Address that receives new quote-request notifications.
DEVIS_NOTIFICATION_EMAIL={{EMAIL}}

# "From" address used for outgoing emails. Must be a domain verified in Resend.
DEVIS_FROM_EMAIL=devis@example.com

# Base URL of the deployed site, used for absolute URLs (OG images, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://example.com
